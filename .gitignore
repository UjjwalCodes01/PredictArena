# ── SECRETS — never commit. CLAUDE.md hard rule 2. ────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
wallets.json
secrets/

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
*.log
npm-debug.log*
pnpm-debug.log*

# ── Build output ─────────────────────────────────────────────────────────────
dist/
build/
.next/
out/
*.tsbuildinfo

# ── Local data (DB is a cache/projection — never a source of truth) ──────────
*.db
*.db-journal
*.sqlite
*.sqlite3
data/

# ── Phase 0 recon artifacts ──────────────────────────────────────────────────
# Scratch output is ignored, but the probe record is committed on purpose: it is
# the Phase 0 exit-gate evidence (tx hashes, market id, outcome) and contains
# only public chain data. `pnpm gate` reads it.
artifacts/*
!artifacts/phase0-probe.json
!artifacts/verify-api.json

# ── Editors / OS ─────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
