# ─────────────────────────────────────────────────────────────────────────────
# Prediction Leagues — environment sample.  Copy to `.env` and fill in.
#
#   cp .env.example .env && pnpm wallets      # generates the four burner keys
#
# `.env` is gitignored (CLAUDE.md hard rule 2).  ONLY fresh testnet burner keys
# ever go in it.  If you ever see a key in a tracked file, STOP and rotate it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network — Somnia Shannon TESTNET ONLY (CLAUDE.md hard rule 1) ────────────
# Chain 5031 (mainnet) is rejected at runtime by scripts/lib/config.ts.
CHAIN_ID=50312
RPC_HTTP_URL=https://dream-rpc.somnia.network
RPC_WS_URL=wss://dream-rpc.somnia.network/ws

# Envio/Hasura indexer that serves Event Contract (binary) markets.
# NOTE: this is NOT stg.api.dreamdex.io — that REST API is spot-only and has no
# event-contract endpoints.  See docs/dex-notes.md §1.
# The mainnet indexer (prd.smk.somnia.host) is rejected at runtime.
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# ── Burner wallets — generated by `pnpm wallets`, NEVER hand-edited ──────────
# DEV = the wallet that places the Phase 0 probe order.
# SEED1..3 = demo-league wallets used later by scripts/seed-demo.ts (Phase 5).
DEV_PRIVATE_KEY=
SEED1_PRIVATE_KEY=
SEED2_PRIVATE_KEY=
SEED3_PRIVATE_KEY=

# ── Phase 0 probe target ────────────────────────────────────────────────────
# Which Up/Down series to place the single recon order against.
# 300s (5 min) is the recommended demo series: fast enough to settle inside a
# 2-3 minute video, slow enough to place a call deliberately.  See dex-notes §4.
TARGET_ASSET=BTC
TARGET_INTERVAL_SEC=300

# Stake for the probe order, in whole tUSDC (testnet collateral is tUSDC with
# 6 decimals — NOT USDso, which is mainnet-only.  See dex-notes.md §2).
STAKE_TUSDC=1

# Optional: pin a venue.  Leave empty to auto-discover from live markets —
# venue ids move (dex-notes.md §5), so auto-discovery is the default.
VENUE_ID=

# ── Database — Neon serverless Postgres ─────────────────────────────────────
# Create a project at neon.tech and paste its POOLED connection string here.
# It is a secret: .env is gitignored and must stay that way.
#   1. pnpm db:generate   (already committed; only needed after a schema change)
#   2. pnpm db:migrate    applies the schema to your Neon project
DATABASE_URL=

# ── Indexer ─────────────────────────────────────────────────────────────────
# Reconciliation is the guarantee; the live tail is only an optimisation.
INDEX_ASSETS=BTC,ETH
INGEST_INTERVAL_MS=20000
RECONCILE_INTERVAL_MS=45000
LOG_LEVEL=info

# Optional. From https://cloud.walletconnect.com — public, identifies the app only.
# Without it the site still works; it just offers injected wallets (MetaMask, Brave) only.
WALLETCONNECT_PROJECT_ID=

# Required only if you drive ingestion from a scheduler instead of running the
# indexer daemon. Any long random string; the /api/cron/ingest endpoint is
# disabled without it.
CRON_SECRET=
